JiffConfigureApp {
    background: $background;
}

#workspace {
    height: 1fr;
}

#controls {
    width: 48;
    min-width: 40;
    padding: 0 1;
    border-right: solid $primary-darken-2;
}

.section-title {
    margin-top: 1;
    text-style: bold;
    color: $accent;
}

#theme {
    width: 100%;
    margin-bottom: 1;
}

#depth,
#palette {
    width: 100%;
}

#style-controls {
    height: auto;
}

.style-control {
    height: auto;
    padding: 1 0;
    border-bottom: solid $panel-lighten-2;
}

.style-title {
    text-style: bold;
}

.colour-fields {
    height: 3;
    align-vertical: middle;
}

.field-label {
    width: auto;
    margin-right: 1;
    color: $text-muted;
}

.background-label {
    margin-left: 1;
}

.colour-select {
    width: 1fr;
}

.indexed-colour {
    width: 1fr;
    min-width: 8;
}

.attribute-fields {
    height: 1;
    align-vertical: middle;
}

Switch.style-switch {
    width: 8;
    height: 1;
    padding: 0 2;
    border: none;
}

Switch.style-switch:focus {
    border: none;
}

#main-actions {
    height: 3;
    margin: 1 0;
    align-horizontal: right;
}

#main-actions Button {
    margin-left: 1;
}

#preview-tabs {
    width: 1fr;
    height: 1fr;
}

#previews {
    width: 1fr;
    height: 1fr;
}

.fallback-notice {
    height: 1;
    padding: 0 1;
    color: $warning;
}

.preview-scroll {
    height: 1fr;
    padding: 1;
    overflow: auto auto;
    color: ansi_default;
    background: ansi_default;
}

.preview {
    width: auto;
    min-width: 100%;
    color: ansi_default;
    background: ansi_default;
}

.toml-preview {
    color: $text;
}

ConfirmDialog,
SavePathDialog,
IndexedColorPicker {
    align: center middle;
    background: $background 60%;
}

.indexed-dialog {
    width: 38;
    height: auto;
    max-height: 100%;
    padding: 0 2;
}

.indexed-dialog .dialog-title {
    margin-bottom: 0;
}

#indexed-grid {
    width: 32;
    height: auto;
    grid-size: 16;
    grid-columns: 2;
    grid-rows: 1;
    grid-gutter: 0;
}

#indexed-default {
    width: 32;
    height: 1;
    padding: 0;
    border: none;
}

ColorSwatch {
    width: 2;
    height: 1;
    pointer: pointer;
}

.indexed-empty {
    width: 2;
    height: 1;
}

ColorSwatch:focus {
    outline: heavy $accent;
}

.dialog {
    width: 64;
    height: auto;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

.save-dialog {
    width: 76;
}

.dialog-title,
.dialog-message {
    margin-bottom: 1;
}

.dialog-title {
    text-style: bold;
}

.dialog-actions {
    height: 3;
    margin-top: 1;
    align-horizontal: right;
}

.dialog-actions Button {
    margin-left: 1;
}
